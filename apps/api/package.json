{
  "name": "@orgmind/api",
  "version": "0.1.0",
  "private": true,
  "author": "Jahid Khan Tuhin",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=../../.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file=../../.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=../../.env --import tsx scripts/seed.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.18",
    "@orgmind/shared": "workspace:*",
    "better-auth": "1.7.18",
    "cors": "2.8.5",
    "express": "5.3.0",
    "helmet": "8.1.0",
    "mongodb": "7.8.0",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "redis": "5.10.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
